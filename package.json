  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "@types/node": "^22.7.4",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "eslint": "^8.57.1",
    "eslint-config-next": "15.5.26",
    "tsx": "4.20.6",
    "sst": "4.17.1",
    "@opennextjs/aws": "3.10.4"
  },
  "overrides": {
    "postcss": "8.5.28"
  }
